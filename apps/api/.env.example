# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5433/life_rpg # required
TEST_DATABASE_URL=postgresql://user:password@localhost:5434/life_rpg_test # required (tests only)

# ── Server ──
NODE_ENV=development # optional
PORT=3000 # optional, defaults to 3000

# ── Auth ──
JWT_SECRET= # required
ACCESS_TOKEN_EXPIRY_MINUTES=15 # optional, defaults to 15
REFRESH_TOKEN_EXPIRY_DAYS=30 # optional, defaults to 30

# ── Google OAuth (unused) ──
GOOGLE_CLIENT_ID= # required when enabled
GOOGLE_CLIENT_SECRET= # required when enabled
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback # required when enabled

# ── Frontend ──
FRONTEND_URL=http://localhost:5173 # unused
