# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5433/life_rpg # required
TEST_DATABASE_URL=postgresql://user:password@localhost:5434/life_rpg_test # required (tests only)

# ── Server ──
NODE_ENV=development # optional
PORT=3000 # optional, defaults to 3000

# ── Auth ──
SESSION_EXPIRY_DAYS=30 # optional, defaults to 30

# ── Google OAuth ──
GOOGLE_CLIENT_ID= # required for Google login
GOOGLE_CLIENT_SECRET= # required for Google login
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google-login/callback

# ── Frontend ──
FRONTEND_URL=http://localhost:5173 # redirect target after Google OAuth
