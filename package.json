{
  "name": "life-rpg",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:nuke": "docker compose down -v",
    "db:generate": "pnpm --filter @life-rpg/database generate",
    "db:migrate": "pnpm --filter @life-rpg/database migrate",
    "db:studio": "pnpm --filter @life-rpg/database studio",
    "db:seed": "pnpm --filter @life-rpg/database seed",
    "test-db:migrate": "pnpm --filter @life-rpg/database test-db:migrate",
    "dev:api": "pnpm --filter @life-rpg/api start:dev",
    "build:api": "pnpm --filter @life-rpg/api build",
    "dev:web": "pnpm --filter @life-rpg/web dev",
    "build:web": "pnpm --filter @life-rpg/web build",
    "test": "pnpm --filter @life-rpg/api test"
  }
}
