{
  "name": "life-rpg",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:nuke": "docker compose down -v",
    "db:generate": "pnpm --filter @life-rpg/database generate",
    "db:migrate": "pnpm --filter @life-rpg/database migrate",
    "db:backup": "pnpm --filter @life-rpg/database backup",
    "db:restore": "pnpm --filter @life-rpg/database restore",
    "db:studio": "pnpm --filter @life-rpg/database studio",
    "db:reset": "docker compose down -v && docker compose up -d && docker compose exec db sh -c 'until pg_isready -U haitianhong; do sleep 0.2; done' && pnpm db:migrate",
    "test-db:migrate": "pnpm --filter @life-rpg/database test-db:migrate",
    "test-db:reset": "docker compose rm -sfv db-test && docker volume rm -f liferpg_pgdata-test && docker compose up -d db-test && docker compose exec db-test sh -c 'until pg_isready -U haitianhong; do sleep 0.2; done' && pnpm test-db:migrate",
    "dev:api": "pnpm --filter @life-rpg/api start:dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @life-rpg/api build",
    "dev:web": "pnpm --filter @life-rpg/web dev",
    "build:web": "pnpm --filter @life-rpg/web build",
    "test": "pnpm --filter @life-rpg/api test",
    "generate:api-client": "pnpm --filter @life-rpg/api-client generate",
    "menu": "npx ntl -A"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
