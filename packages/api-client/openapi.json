  "info": {
    "title": "LifeRPG API",
    "description": "",
    "version": "0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "tokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "tokenExpiresAt"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "UserDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "level": {
            "type": "number"
          },
          "xp": {
            "type": "number"
          },
          "coins": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "level",
          "xp",
          "coins",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "firstName"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "TaskBlockResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "amount": {
            "type": "number",
            "nullable": true
          },
          "xpReward": {
            "type": "number"
          },
          "coinReward": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "xpReward",
          "coinReward"
        ]
      },
      "TaskResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "userId": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "amountUnit": {
            "type": "string",
            "enum": [
              "minutes"
            ],
            "nullable": true
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskBlockResponseDto"
            }
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "blocks"
        ]
      },
      "CreateTaskBlockDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "nullable": true
          },
          "xpReward": {
            "type": "number",
            "default": 0
          },
          "coinReward": {
            "type": "number",
            "default": 0
          }
        }
      },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "amountUnit": {
            "type": "string",
            "enum": [
              "minutes"
            ],
            "nullable": true
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateTaskBlockDto"
            }
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateTaskBlockDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "nullable": true
          },
          "xpReward": {
            "type": "number",
            "default": 0
          },
          "coinReward": {
            "type": "number",
            "default": 0
          },
          "id": {
            "type": "number"
          },
          "delete": {
            "type": "boolean"
          }
        }
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "amountUnit": {
            "type": "string",
            "enum": [
              "minutes"
            ],
            "nullable": true
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateTaskBlockDto"
            }
          }
        }
      },
      "CompleteTaskDto": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "number"
          }
        },
        "required": [
          "blockId"
        ]
      },
      "TaskCompletionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "taskId": {
            "type": "number"
          },
          "userId": {
            "type": "number"
          },
          "xpEarned": {
            "type": "number"
          },
          "coinsEarned": {
            "type": "number"
          },
          "completedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "taskId",
          "userId",
          "xpEarned",
          "coinsEarned",
          "completedAt"
        ]
      }
    }
  }
}
